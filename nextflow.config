/*
 * Nextflow configuration for the unified low-pass variant workflow.
 * Split-process build: caller stages are visible separately in the terminal,
 * trace, timeline, DAG, and execution report.
 *
 * Run:
 *   ./bin/run_pipeline.sh -profile conda --ffpe|--fresh [params]
 */


// Config parser v2 / strict syntax compatible: no top-level Groovy def declarations.
// Reporting is enabled only when --outdir is provided, preventing unwanted
// lowpass_variants_results folders during --help.

manifest {
    name            = 'lowpass-variants-nextflow'
    author          = 'Carlos Farkas'
    description     = 'Unified low-pass per-sample SNV/indel workflow with fresh and FFPE modes, BQSR, caller normalization, and optional FFPErase annotation.'
    version         = '1.0.0'
    nextflowVersion = '>=24.10.0'
}

params {
    help                      = false
    show_help                 = false
    h                         = false
    help_full                 = false
    show_hidden               = false
    showHidden                = false
    ffpe                      = false
    fresh                     = false
    input                     = null
    outdir                    = null
    ref                       = null
    samples                   = ''
    recursive                 = false
    database_tsv              = ''
    metadata_tsv              = ''
    cohort                    = 'all'

    genes                     = ''
    bed                       = ''
    target_bed                = ''
    gtf                       = ''
    gencode_version           = '45'
    promoter_upstream         = 2000
    promoter_downstream       = 500

    // Backward-compatible global setting. Mutect2 uses this by default.
    threads                   = 12

    // Stage-level CPU control. For true concurrent caller execution, lower these
    // values enough that Nextflow can schedule multiple caller tasks at once.
    prepare_cpus              = 12
    mutect2_cpus              = 12
    freebayes_cpus            = 1
    bcftools_cpus             = 8
    normalize_cpus            = 4
    finalize_cpus             = 4

    // Stage-level parallelism. These are plain integers, not closures, to avoid
    // closure/integer comparison errors in recent Nextflow/Groovy versions.
    max_samples_parallel      = 4
    max_parallel_samples      = 4
    max_prepare_parallel      = 4
    max_mutect2_parallel      = 4
    max_freebayes_parallel    = 4
    max_bcftools_parallel     = 4
    max_normalize_parallel    = 4
    max_finalize_parallel     = 4

    memory                    = '24 GB'
    mutect2_memory            = '24 GB'
    freebayes_memory          = '12 GB'
    bcftools_memory           = '12 GB'
    normalize_memory          = '8 GB'
    finalize_memory           = '8 GB'
    time                      = '72h'
    caller_time               = '72h'
    quick_time                = '12h'

    duplicate_mode            = 'skip'
    force_rg_sm_basename      = false
    known_sites               = ''
    skip_bqsr                 = false
    germline_resource         = ''
    panel_of_normals          = ''
    pon                       = ''

    skip_mutect2              = false
    skip_freebayes            = false
    skip_bcftools             = false

    min_mapq                  = 20
    min_bq                    = 20
    min_dp                    = 10
    min_alt_reads             = 4
    min_af                    = '0.20'
    vote_threshold            = 2
    ffpe_ct_vaf_keep          = '0.35'
    ffpe_ct_min_alt           = 8
    include_obvious_artifacts = false
    auto_thresholds           = true

    // FFPErase is invoked only when --ffpe is selected. The external workflow
    // is resolved at the pinned revision and remains subject to upstream terms.
    ffperase_threads           = 16
    ffperase_classify_threads  = 2
    ffperase_sample_jobs       = 1
    ffperase_picard_jobs       = 1
    ffperase_split_pileup      = 5000
    ffperase_split_reads       = 7500000
    ffperase_memory            = '32 GB'
    ffperase_time              = '168h'
    ffperase_container         = 'auto'
    ffperase_engine            = 'auto'
    ffperase_repository        = 'papaemmelab/nf-ffperase'
    ffperase_revision          = 'b0dd56cbd0a939896a966b9ce30c4d719b158170'
    ffperase_filter_artifacts  = true
    ffperase_fail_on_error     = true

    pipeline_container        = 'ghcr.io/cfarkas/lowpass-variants-nextflow:1.0.0'
    docker_socket             = '/var/run/docker.sock'

    overwrite                 = false
    dry_run                   = false

}

conda {
    enabled = false
}

process {
    executor = 'local'
    errorStrategy = 'terminate'
    stageInMode = 'symlink'
}

profiles {
    conda {
        conda.enabled = true
        process.executor = 'local'
    }

    local {
        conda.enabled = true
        process.executor = 'local'
    }

    docker {
        conda.enabled = false
        docker.enabled = true
        docker.runOptions = '-u $(id -u):$(id -g) -e HOME=$PWD'
        params.ffperase_engine = 'docker'
        process {
            executor = 'local'
            container = params.pipeline_container
            // Input discovery runs on the host, then downstream path inputs are staged.
            withName: RESOLVE_BAMS {
                container = null
            }
            withName: FFPERASE {
                // This task alone receives daemon access for its nested FFPE run.
                containerOptions = '-v ' + params.docker_socket + ':/var/run/docker.sock --group-add $(stat -c %g ' + params.docker_socket + ') -e NXF_HOME=$PWD/.ffperase-nxf-home'
            }
        }
    }

    slurm {
        conda.enabled = true
        process.executor = 'slurm'
        process.queue = null
    }
}

timeline {
    enabled   = (params.outdir != null)
    file      = "${params.outdir ?: 'lowpass_variants_results'}/nextflow_info/timeline.html"
    overwrite = true
}

report {
    enabled   = (params.outdir != null)
    file      = "${params.outdir ?: 'lowpass_variants_results'}/nextflow_info/report.html"
    overwrite = true
}

trace {
    enabled   = (params.outdir != null)
    file      = "${params.outdir ?: 'lowpass_variants_results'}/nextflow_info/trace.txt"
    overwrite = true
}

dag {
    enabled   = (params.outdir != null)
    file      = "${params.outdir ?: 'lowpass_variants_results'}/nextflow_info/dag.html"
    overwrite = true
}
